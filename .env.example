# ===== LLM（OpenAI 兼容，必填其一）=====
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# DASHSCOPE_API_KEY=sk-your-dashscope-key
MODEL_NAME=qwen-max
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3

# ===== RAG =====
RAG_MODE=mock
# RAG_MODE=chroma  # 生产向量检索
EMBEDDING_MODE=local
# EMBEDDING_MODE=online  # DashScope Embedding API (text-embedding-v4)
# 本地 Embedding 模型（默认 Qwen3-Embedding-0.6B，1024 维，instruction-aware）
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# online 模式 DashScope Embedding 模型名
EMBEDDING_ONLINE_MODEL_NAME=text-embedding-v4
# 查询嵌入 prompt 名称（Qwen3-Embedding 需 "query"；留空按模型名自动检测）
EMBEDDING_QUERY_PROMPT_NAME=
# EMBEDDING_DEVICE=cuda  # 无 GPU 时改 cpu

# ===== 运行环境 =====
ENVIRONMENT=development
LOG_LEVEL=INFO
