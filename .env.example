# ===== LLM（任意 OpenAI 兼容服务，必填）=====
OPENAI_API_KEY=sk-your-key-here
OPENAI_BASE_URL=https://api.openai.com/v1
MODEL_NAME=gpt-4o-mini
LLM_TIMEOUT=120
LLM_MAX_RETRIES=3
# 单次生成最大 token 数（按厂商上限调整，超出会报 400）
LLM_MAX_TOKENS=8192
# 结构化输出方式: function_calling（默认）/ json_schema / json_mode
LLM_STRUCTURED_OUTPUT_METHOD=function_calling
# 部分网关要求专用请求头才能路由（留空表示不附加）
LLM_EXTRA_HEADERS=

# 常见厂商示例：只需替换上面三行（API Key / Base URL / 模型名）
#   OpenAI:     OPENAI_BASE_URL=https://api.openai.com/v1
#               MODEL_NAME=gpt-4o-mini
#   DashScope:  OPENAI_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
#               MODEL_NAME=qwen-max
#   DeepSeek:   OPENAI_BASE_URL=https://api.deepseek.com/v1
#               MODEL_NAME=deepseek-chat
#   本地 vLLM/Ollama（无鉴权时 Key 填占位值）:
#               OPENAI_BASE_URL=http://localhost:8000/v1
#               MODEL_NAME=<部署的模型名>
#               OPENAI_API_KEY=not-needed
#   第三方网关（base_url 必须带 /v1）:
#               OPENAI_BASE_URL=https://opencode.ai/zen/go/v1
#               LLM_EXTRA_HEADERS={"x-opencode-session":"<任意 uuid4>"}

# ===== RAG =====
RAG_MODE=mock
# RAG_MODE=chroma  # 生产向量检索
EMBEDDING_MODE=local
# EMBEDDING_MODE=online  # 任意 OpenAI 兼容 Embedding API
# 本地 Embedding 模型（默认 Qwen3-Embedding-0.6B，1024 维，instruction-aware）
EMBEDDING_MODEL_NAME=Qwen/Qwen3-Embedding-0.6B
# online 模式 Embedding 模型名（按厂商填写）
EMBEDDING_ONLINE_MODEL_NAME=text-embedding-3-small
# 在线 Embedding 独立端点（留空回退 OPENAI_API_KEY / OPENAI_BASE_URL）
EMBEDDING_ONLINE_API_KEY=
EMBEDDING_ONLINE_BASE_URL=
# 查询嵌入 prompt 名称（Qwen3-Embedding 需 "query"；留空按模型名自动检测）
EMBEDDING_QUERY_PROMPT_NAME=
# EMBEDDING_DEVICE=cuda  # 无 GPU 时改 cpu

# ===== 运行环境 =====
ENVIRONMENT=development
LOG_LEVEL=INFO
