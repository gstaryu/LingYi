# Langfuse 自托管环境变量（本地开发默认值）
# 使用：把本文件复制为同目录下的 .env，按需修改
#   cd deploy/langfuse && cp .env.example .env
#
# 安全提示：以下口令只适合本机使用。若把服务暴露到局域网/公网，必须全部更换，
# 并给 langfuse-web 配置 HTTPS 反向代理。

# --- Langfuse 服务端 ---
NEXTAUTH_URL=http://localhost:3001
# 宿主端口；默认 3001，避开灵医前端 Next.js 的 3000
LANGFUSE_PORT=3001
NEXTAUTH_SECRET=dev-nextauth-secret-change-me
SALT=dev-salt-change-me
# 64 位十六进制；可用 `openssl rand -hex 32` 或 python -c "import secrets;print(secrets.token_hex(32))" 重新生成
ENCRYPTION_KEY=e9fb499cca12d68b99803fb07d132828f547522c8f2a941e611fe8f098fb269e
# 关闭匿名使用统计上报，避免向 langfuse.com 发送数据
TELEMETRY_ENABLED=false

# --- 依赖组件口令 ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=postgres
CLICKHOUSE_USER=clickhouse
CLICKHOUSE_PASSWORD=clickhouse
REDIS_AUTH=dev-redis-secret
MINIO_ROOT_USER=minio
MINIO_ROOT_PASSWORD=miniosecret
LANGFUSE_S3_EVENT_UPLOAD_SECRET_ACCESS_KEY=miniosecret
LANGFUSE_S3_MEDIA_UPLOAD_SECRET_ACCESS_KEY=miniosecret

# --- 首次启动自动创建组织 / 项目 / 登录用户 ---
# 固定 API Key 可省去在 UI 里手动创建项目再复制 Key 的步骤；
# 把下面两个值原样填到 LingYi 根目录 .env 的 LANGFUSE_PUBLIC_KEY / LANGFUSE_SECRET_KEY。
LANGFUSE_INIT_ORG_ID=lingyi
LANGFUSE_INIT_ORG_NAME=LingYi
LANGFUSE_INIT_PROJECT_ID=lingyi
LANGFUSE_INIT_PROJECT_NAME=LingYi
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-lingyi-local
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-lingyi-local
LANGFUSE_INIT_USER_EMAIL=admin@lingyi.local
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=lingyi123456
